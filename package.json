{
  "name": "@blockvectra/data-api",
  "version": "0.1.0",
  "description": "TypeScript client for the BlockVectra Data API",
  "keywords": [
    "blockchain",
    "data-api",
    "sdk",
    "typescript"
  ],
  "homepage": "https://docs.blockvectra.com/en/",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate:schema": "tsx scripts/generate-schema.ts",
    "prebuild": "npm run generate:schema",
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "npm run generate:schema",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run generate:schema",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
