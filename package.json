{
  "name": "@blockvectra/data-api",
  "version": "0.1.4",
  "description": "TypeScript client for the BlockVectra Data API",
  "keywords": [
    "blockchain",
    "data-api",
    "sdk",
    "typescript"
  ],
  "homepage": "https://docs.blockvectra.com/en/api/data/",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "examples"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate:schema": "tsx scripts/generate-schema.ts",
    "prepare": "npm run build",
    "prebuild": "npm run generate:schema",
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "npm run generate:schema",
    "typecheck": "tsc --noEmit && tsx scripts/typecheck-readme.ts",
    "typecheck:readme": "tsx scripts/typecheck-readme.ts",
    "pretest": "npm run generate:schema",
    "test": "vitest run src && node --test scripts/verify-publication.test.mjs scripts/address-transfers-page.test.mjs",
    "verify:publication": "node scripts/verify-publication.mjs",
    "test:publication": "node --test scripts/verify-publication.test.mjs"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blockvectra/data-api-js.git"
  }
}
